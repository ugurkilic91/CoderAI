<Project>
  <!--
    Build settings shared by every DevAgents project (tests/Directory.Build.props imports this file).
    Kept under src/ instead of the repository root so it does not leak into the projects under projects/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
  </PropertyGroup>
</Project>
