<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Presentation layer and composition root: HTTP endpoints, web chat UI (wwwroot), configuration, prompts. -->
  <PropertyGroup>
    <RootNamespace>DevAgents.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent system prompts: editable text files, read on every request -->
    <None Update="prompts\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevAgents.Application\DevAgents.Application.csproj" />
    <ProjectReference Include="..\DevAgents.Infrastructure\DevAgents.Infrastructure.csproj" />
  </ItemGroup>

</Project>
