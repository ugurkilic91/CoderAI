# docker compose ayarları: "cp .env.example .env" ile kopyalayıp bu sunucuya göre düzenleyin.

# Ajanların okuyup kod yazacağı projelerin üst klasörü (ana makinedeki mutlak yol).
PROJECTS_DIR=/srv/projeler
# DevAgents verileri: NuGet önbelleği (ilk derlemede ~1 GB), değişiklik geçmişi (ana makinedeki mutlak yol, DEVAGENTS_UID yazabilmeli).
DATA_DIR=/srv/devagents-data
# Bu deponun ana makinedeki mutlak yolu (mimari şablonu buradan bağlanır).
DEVAGENTS_DIR=/opt/devagents

# DevAgents'in çalışacağı kullanıcı = projelerin sahibi ("id -u" ve "id -g"); docker grubunun numarası ("getent group docker").
DEVAGENTS_UID=1000
DEVAGENTS_GID=1000
DOCKER_GID=999

# Ollama ana makinede değilse (örn. with-ollama profili ile): http://ollama:11434
# OLLAMA_URL=http://host.docker.internal:11434
